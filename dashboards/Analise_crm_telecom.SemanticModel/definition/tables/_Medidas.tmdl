table _Medidas
	lineageTag: 9544ce5f-6da3-4ca7-bb56-abf04704c0a2

	measure 'Clientes Ativos' =
			VAR _MaxData = MAX('crm_telecom customer_monthly'[month_start])
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('crm_telecom customer_monthly'[customer_id]),
			    'crm_telecom customer_monthly'[active_flag] = 1,
			    'crm_telecom customer_monthly'[month_start] = _MaxData
			)
		formatString: #,##0
		displayFolder: Métricas de Base
		lineageTag: 577782de-354f-4d0b-9a04-8b1df66c4455

	measure 'ARPU Atual' = DIVIDE([Faturamento Total], [Clientes Ativos], 0)
		formatString: R$ #,##0.00
		displayFolder: Métricas Financeiras
		lineageTag: a9dc3f6a-9540-4cb7-8f85-fa58fcf94b8c

	measure 'Taxa Churn Atual' = ```
			VAR _MaxData = MAX('crm_telecom customer_monthly'[month_start])
			VAR _Cancelados = 
			    CALCULATE(
			        DISTINCTCOUNT('crm_telecom customer_monthly'[customer_id]),
			        'crm_telecom customer_monthly'[churn_flag] = 1,
			        'crm_telecom customer_monthly'[month_start] = _MaxData
			    )
			RETURN
			DIVIDE(_Cancelados, [Clientes Ativos], 0)
			```
		formatString: 0.00%
		displayFolder: Métricas de Churn
		lineageTag: 905c3fc7-ebb4-4a14-a6c9-8d959f7dfc69

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Receita sob Risco Atual' =
			VAR _MaxData = MAX('crm_telecom customer_monthly'[month_start])
			RETURN
			CALCULATE(
			    SUM('crm_telecom customer_monthly'[revenue_at_risk]),
			    'crm_telecom customer_monthly'[month_start] = _MaxData
			)
		formatString: R$ #,##0.00
		displayFolder: Métricas Financeiras
		lineageTag: f96c0d89-faae-4ce3-8df1-bb8940c059d2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Taxa Retencao %' =
			
			DIVIDE(
			    AVERAGE('crm_telecom cohort_retention'[retention_rate]),
			    100
			)
		lineageTag: 7da30c0d-5cf2-424b-a736-b14bf501ecf2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Faturamento Total' =
			VAR _MaxData = MAX('crm_telecom customer_monthly'[month_start])
			RETURN
			CALCULATE(
			    SUM('crm_telecom customer_monthly'[recognized_revenue]),
			    'crm_telecom customer_monthly'[month_start] = _MaxData
			)
		formatString: R$ #,##0.00
		displayFolder: Métricas Financeiras
		lineageTag: e413ee75-4847-45d0-a1f3-7286dc9f4aed

	measure 'Qtd Clientes Ativos' = CALCULATE(DISTINCTCOUNT('crm_telecom customer_monthly'[customer_id]), 'crm_telecom customer_monthly'[active_flag] = 1)
		formatString: #,##0
		displayFolder: Composição de Base
		lineageTag: ad18ea81-711c-4f33-88c7-d14121e8d466

	measure 'Qtd Clientes Grace Period' = CALCULATE(DISTINCTCOUNT('crm_telecom customer_monthly'[customer_id]), 'crm_telecom customer_monthly'[revenue_at_risk] > 0)
		formatString: #,##0
		displayFolder: Composição de Base
		lineageTag: 85c1064e-bf29-441f-9b2a-22d26923131b

	measure 'Qtd Clientes Churn' = CALCULATE(DISTINCTCOUNT('crm_telecom customer_monthly'[customer_id]), 'crm_telecom customer_monthly'[churn_flag] = 1)
		formatString: #,##0
		displayFolder: Composição de Base
		lineageTag: eeba42c0-b4ac-4784-92bc-172ff02a1f0c

	measure 'Taxa Retencao Cohort %' = ```
			VAR _ClientesAtivosNoTenure = 
			    CALCULATE(
			        DISTINCTCOUNT('crm_telecom customer_monthly'[customer_id]),
			        'crm_telecom customer_monthly'[active_flag] = 1
			    )
			VAR _ClientesIniciaisCohort = 
			    CALCULATE(
			        DISTINCTCOUNT('crm_telecom customer_monthly'[customer_id]),
			        'crm_telecom customer_monthly'[tenure_month] = 0,
			        'crm_telecom customer_monthly'[active_flag] = 1,
			        REMOVEFILTERS('crm_telecom customer_monthly'[tenure_month])
			    )
			RETURN 
			DIVIDE(_ClientesAtivosNoTenure, _ClientesIniciaisCohort, 0)
			```
		formatString: 0.00%
		displayFolder: Análise de Cohort
		lineageTag: 0588fa3f-58ae-4ebf-82d6-cc92c59f3d00

	column Column
		formatString: 0
		lineageTag: faf66e48-360e-47ce-a8b5-6f49a012f4e0
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition _Medidas = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 8e7cca6b14464eec91e8d9b057f7570a

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":""}

